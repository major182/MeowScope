# 開発用の値の見本。Copy-Item .env.example .env で使う（.env はコミットしない）
# 本物の秘密情報はここに書かない

# DB（compose.yaml とサーバーの両方が使う）。.env には自分で決めた長いパスワードを書く
DB_USER=meowscope
DB_PASSWORD=change-me
# ログに出す環境の名前と版（ログ設計書 2章）
MEOWSCOPE_ENV=local
MEOWSCOPE_VERSION=dev
# サーバーを公開する手元のポート
SERVER_PORT=8080
# アクセストークンの署名鍵（32 バイト以上を Base64 で）。作り方：openssl rand -base64 32
JWT_SECRET=
# パスワードの再設定のメール（SMTP）。MAIL_HOST と MAIL_FROM が空なら送らない
# 例（Gmail）：MAIL_HOST=smtp.gmail.com、MAIL_PORT=587、MAIL_USERNAME と MAIL_FROM に送り元のアドレス、
# MAIL_PASSWORD にアプリパスワード（本物の値はここに書かず、.env か秘密の置き場に置く）
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
