# 開発用の値の見本。Copy-Item .env.example .env で使う（.env はコミットしない）
# 本物の秘密情報はここに書かない

# DB（compose.yaml とサーバーの両方が使う）。.env には自分で決めた長いパスワードを書く
DB_USER=meowscope
DB_PASSWORD=change-me
# ログに出す環境の名前と版（ログ設計書 2章）
MEOWSCOPE_ENV=local
MEOWSCOPE_VERSION=dev
# サーバーを公開する手元のポート
SERVER_PORT=8080
# アクセストークンの署名鍵（32 バイト以上を Base64 で）。作り方：openssl rand -base64 32
JWT_SECRET=
# パスワードの再設定のメール（SMTP）。MAIL_HOST と MAIL_FROM が空なら送らない
# 例（Resend。デプロイ設計書 2.4）：MAIL_HOST=smtp.resend.com、MAIL_PORT=587、MAIL_USERNAME=resend、
# MAIL_FROM=noreply@meowscope.dev、MAIL_PASSWORD に Resend の API キー（本番と開発で別のキー。本物の値はここに書かず、.env に置く）
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# 配布版を作るときの値（deploy/publish-release.sh が読む。デプロイ設計書 6.4）。サーバーは使わない
# CONTACT_EMAIL：アプリの問い合わせの画面に出す宛先。API_BASE_URL：配布版がつなぐサーバーの URL（末尾は /api/v1）
CONTACT_EMAIL=
API_BASE_URL=
