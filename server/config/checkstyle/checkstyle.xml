<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- 書式は Spotless に任せ、ここではバグや読みにくさにつながる書き方に絞る -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <module name="FileTabCharacter"/>
    <!-- テストのメソッド名は日本語で書くため -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="MethodName"/>
        <property name="files" value="[\/]src[\/]test[\/]"/>
    </module>
    <!-- Spring Boot の起動クラスは public コンストラクタが必要なため -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="HideUtilityClassConstructor"/>
        <property name="files" value="Application\.java$"/>
    </module>
    <module name="TreeWalker">
        <module name="TypeName"/><module name="MethodName"/><module name="MemberName"/>
        <module name="ParameterName"/><module name="LocalVariableName"/>
        <!-- ロガーは慣習どおり log と書けるようにする -->
        <module name="ConstantName"><property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/></module>
        <module name="AvoidStarImport"/><module name="UnusedImports"/><module name="RedundantImport"/>
        <module name="EmptyBlock"/><module name="EmptyStatement"/><module name="EqualsHashCode"/>
        <module name="MissingSwitchDefault"/><module name="FallThrough"/><module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/><module name="NeedBraces"/><module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/><module name="ModifierOrder"/><module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>
    </module>
</module>
