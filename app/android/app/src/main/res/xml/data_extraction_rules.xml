<?xml version="1.0" encoding="utf-8"?>
<!--
  アプリのデータを OS のバックアップと端末間の移行に出さない（NF-SC-10）。
  なぜ：記録の DB・写真・ログインの情報が、Google のバックアップや別の端末へ
  そのまま写るのを防ぐ。
  Android 11 以前は AndroidManifest の allowBackup="false" で止まる。
  Android 12 以降は allowBackup だけでは端末間の移行が止まらないため、ここで外す。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
