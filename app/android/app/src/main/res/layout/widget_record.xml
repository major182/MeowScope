<?xml version="1.0" encoding="utf-8"?>
<!-- 記録のウィジェット（画面設計書「Android のウィジェット」）。2×2 の枠と、上の見出し、枠の代わりに出す案内 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_message"
        style="@style/WidgetText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_grid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            style="@style/WidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="4dp"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/widget_cell0" style="@style/WidgetCell" />
            <TextView android:id="@+id/widget_cell1" style="@style/WidgetCell" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView android:id="@+id/widget_cell2" style="@style/WidgetCell" />
            <TextView android:id="@+id/widget_cell3" style="@style/WidgetCell" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
